import Derivation.TraceAlgebra

/-!
# Cells generated by verified swaps

AuthorityEffect: None.  A **swap** exchanges two adjacent events of an
event list from a start state `s`.  It is admitted only when, at the actual
state that the prefix reaches, the two orders of the pair reach the same
state.  A **cell** is a step of the equivalence closure of swaps.  Cells
are between event lists; by `cell_sound` they relate parallel native paths
(same start, same end).

Proved here:

* `swap_sound`, `cell_sound`: related lists replay to the same state.
* `cell_perm`: related lists are permutations of each other.
* `cell_append_right`, `cell_append_left`, `cell_hcomp`: cells whisker on
  both sides and compose horizontally.
* `swap_license`, `swap_budget`, `swap_occ`: the sealed frame
  commutations are swap generators at every state.
* `parallel_not_cell`: two parallel native paths from genesis to genesis
  are not related by any cell.  So cells are strictly finer than
  "parallel", the relation a syntactic step-commutation cell would give.

`Cell` is a proposition, so any two cells between the same lists are
equal.  The composition laws of cells therefore hold trivially.  A
proof-relevant cell calculus, where the order of swaps is data, is not
constructed here.
-/

namespace ResearchNativeStructure

open PrimitivePassage TraceAlgebra TransitionAlphabet

/-- One verified swap of adjacent events. -/
inductive Swap (s : PState) : List PEvent → List PEvent → Prop where
  | mk (a b : List PEvent) (e₁ e₂ : PEvent)
      (h : step (step (replayP a s) e₁) e₂ = step (step (replayP a s) e₂) e₁) :
      Swap s (a ++ e₁ :: e₂ :: b) (a ++ e₂ :: e₁ :: b)

/-- The equivalence closure of verified swaps. -/
inductive Cell (s : PState) : List PEvent → List PEvent → Prop where
  | refl (l : List PEvent) : Cell s l l
  | swap {l l' : List PEvent} : Swap s l l' → Cell s l l'
  | symm {l l' : List PEvent} : Cell s l l' → Cell s l' l
  | trans {l l' l'' : List PEvent} : Cell s l l' → Cell s l' l'' → Cell s l l''

theorem swap_sound {s : PState} {l l' : List PEvent} (h : Swap s l l') :
    replayP l s = replayP l' s := by
  cases h with
  | mk a b e₁ e₂ hc =>
      rw [replay_append, replay_append]
      show replayP b (step (step (replayP a s) e₁) e₂) =
        replayP b (step (step (replayP a s) e₂) e₁)
      rw [hc]

theorem cell_sound {s : PState} {l l' : List PEvent} (h : Cell s l l') :
    replayP l s = replayP l' s := by
  induction h with
  | refl _ => rfl
  | swap h => exact swap_sound h
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

theorem swap_perm {s : PState} {l l' : List PEvent} (h : Swap s l l') : l.Perm l' := by
  cases h with
  | mk a b e₁ e₂ _ => exact List.Perm.append_left a (List.Perm.swap e₂ e₁ b)

theorem cell_perm {s : PState} {l l' : List PEvent} (h : Cell s l l') : l.Perm l' := by
  induction h with
  | refl _ => exact List.Perm.refl _
  | swap h => exact swap_perm h
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

theorem swap_append_right {s : PState} {l l' : List PEvent} (m : List PEvent)
    (h : Swap s l l') : Swap s (l ++ m) (l' ++ m) := by
  cases h with
  | mk a b e₁ e₂ hc =>
      have h' := Swap.mk (s := s) a (b ++ m) e₁ e₂ hc
      simpa [List.append_assoc] using h'

theorem cell_append_right {s : PState} {l l' : List PEvent} (m : List PEvent)
    (h : Cell s l l') : Cell s (l ++ m) (l' ++ m) := by
  induction h with
  | refl _ => exact Cell.refl _
  | swap h => exact Cell.swap (swap_append_right m h)
  | symm _ ih => exact Cell.symm ih
  | trans _ _ ih₁ ih₂ => exact Cell.trans ih₁ ih₂

theorem swap_append_left {s : PState} (k : List PEvent) {l l' : List PEvent}
    (h : Swap (replayP k s) l l') : Swap s (k ++ l) (k ++ l') := by
  cases h with
  | mk a b e₁ e₂ hc =>
      have hc' : step (step (replayP (k ++ a) s) e₁) e₂ =
          step (step (replayP (k ++ a) s) e₂) e₁ := by
        rw [replay_append]; exact hc
      have h' := Swap.mk (s := s) (k ++ a) b e₁ e₂ hc'
      simpa [List.append_assoc] using h'

theorem cell_append_left {s : PState} (k : List PEvent) {l l' : List PEvent}
    (h : Cell (replayP k s) l l') : Cell s (k ++ l) (k ++ l') := by
  induction h with
  | refl _ => exact Cell.refl _
  | swap h => exact Cell.swap (swap_append_left k h)
  | symm _ ih => exact Cell.symm ih
  | trans _ _ ih₁ ih₂ => exact Cell.trans ih₁ ih₂

/-- **Horizontal composition.** -/
theorem cell_hcomp {s : PState} {l l' m m' : List PEvent} (hl : Cell s l l')
    (hm : Cell (replayP l s) m m') : Cell s (l ++ m) (l' ++ m') := by
  have h1 : Cell s (l ++ m) (l' ++ m) := cell_append_right m hl
  have hm' : Cell (replayP l' s) m m' := by rw [← cell_sound hl]; exact hm
  exact Cell.trans h1 (cell_append_left l' hm')

/-! ## Frame generators from the sealed commutation theorems -/

theorem swap_license (s : PState) (a b : List PEvent) (bl : Bool) (e : PEvent)
    (h : licenseInsensitive e = true) :
    Swap s (a ++ .setLicense bl :: e :: b) (a ++ e :: .setLicense bl :: b) :=
  Swap.mk a b _ _ (comm_setLicense (replayP a s) bl e h)

theorem swap_budget (s : PState) (a b : List PEvent) (n : Nat) (e : PEvent)
    (h : budgetInsensitive e = true) :
    Swap s (a ++ .setBudget n :: e :: b) (a ++ e :: .setBudget n :: b) :=
  Swap.mk a b _ _ (comm_setBudget (replayP a s) n e h)

theorem swap_occ (s : PState) (a b : List PEvent) (t : Nat) (e : PEvent)
    (h : occInsensitive e = true) :
    Swap s (a ++ .admitOcc t :: e :: b) (a ++ e :: .admitOcc t :: b) :=
  Swap.mk a b _ _ (comm_admitOcc (replayP a s) t e h)

/-! ## Cells are finer than parallelism -/

def budgetLoop : List PEvent := [.setBudget 1, .setBudget 0]
def licenseLoop : List PEvent := [.setLicense false, .setLicense true]

/-- Two parallel native paths, both from genesis back to genesis, that no
cell relates. -/
theorem parallel_not_cell :
    replayP budgetLoop genesisP = genesisP ∧
      replayP licenseLoop genesisP = genesisP ∧
      ¬ Cell genesisP budgetLoop licenseLoop := by
  refine ⟨rfl, rfl, fun h => ?_⟩
  have hp := cell_perm h
  have hm : PEvent.setBudget 1 ∈ licenseLoop :=
    hp.subset (List.mem_cons_self ..)
  simp [licenseLoop] at hm

end ResearchNativeStructure
