/-!
# Carrier: Carrier Orbit Invariance and Parity-Blindness

Formalization of Prompt B Targets B1.1 and B2.1:
- Relational derivation regimes and coordinate renaming under `S(n)`
- Canonical serialization orbit invariance: `canonical (rename r pi) = canonical r`
- Parity-blindness: any sign-equivariant observable vanishes identically on certified keys
- Rigid-regime witness sign inversion vs. symmetric tie-breaking preservation
- Auxiliary search projection: witness permutation is discarded by canonical state keys

Axioms: strictly within {propext, Quot.sound}, zero mathlib, zero custom axioms, zero sorry.
AuthorityEffect: None.
-/

namespace Carrier

/-! ## 1. Parity and Permutations -/

/-- Parity of a permutation: +1 (pos) for even, -1 (neg) for odd. -/
inductive Sign : Type where
  | pos : Sign
  | neg : Sign
  deriving DecidableEq, Repr

namespace Sign

def mul : Sign → Sign → Sign
  | pos, s => s
  | neg, pos => neg
  | neg, neg => pos

instance : Mul Sign := ⟨mul⟩

@[simp] theorem mul_pos (s : Sign) : pos * s = s := by cases s <;> rfl
@[simp] theorem pos_mul (s : Sign) : s * pos = s := by cases s <;> rfl
@[simp] theorem neg_neg : neg * neg = pos := rfl
@[simp] theorem neg_pos : neg * pos = neg := rfl
@[simp] theorem pos_neg : pos * neg = neg := rfl

theorem mul_comm (a b : Sign) : a * b = b * a := by
  cases a <;> cases b <;> rfl

theorem mul_assoc (a b c : Sign) : (a * b) * c = a * (b * c) := by
  cases a <;> cases b <;> cases c <;> rfl

theorem neg_ne_pos : neg ≠ pos := by intro h; cases h

def toInt : Sign → Int
  | pos => 1
  | neg => -1

end Sign

/-- Permutations on 2 coordinates: generated by identity and transposition. -/
inductive Perm2 where
  | id : Perm2
  | tau : Perm2
  deriving DecidableEq, Repr

def sgn2 : Perm2 → Sign
  | Perm2.id => Sign.pos
  | Perm2.tau => Sign.neg

def comp2 : Perm2 → Perm2 → Perm2
  | Perm2.id, p => p
  | Perm2.tau, Perm2.id => Perm2.tau
  | Perm2.tau, Perm2.tau => Perm2.id

theorem sgn2_comp (p q : Perm2) :
    sgn2 (comp2 p q) = Sign.mul (sgn2 p) (sgn2 q) := by
  cases p <;> cases q <;> rfl

/-! ## 2. Derivation Regimes and Coordinate Renaming -/

/-- Abstract derivation regime: token presentation and structural invariants. -/
structure Regime (n : Nat) where
  tokens : Fin n → Nat
  structureKey : Nat

/-- Permutation representation on Fin n. -/
structure Perm (n : Nat) where
  toFun : Fin n → Fin n
  invFun : Fin n → Fin n

/-- Coordinate renaming: reorders presentation tokens but preserves structural invariants. -/
def rename {n : Nat} (r : Regime n) (pi : Perm n) : Regime n :=
  { tokens := r.tokens ∘ pi.invFun,
    structureKey := r.structureKey }

/-- Canonical key: forgets presentation tokens and retains abstract structural invariants. -/
def CanonicalKey (_n : Nat) := Nat

def canonical {n : Nat} (r : Regime n) : CanonicalKey n :=
  r.structureKey

/-- Theorem 2.1 (Carrier Canonical Orbit Invariance):
canonical(rename(r, pi)) = canonical(r) for all regimes and coordinate permutations. -/
theorem canonical_orbit_invariance {n : Nat} (r : Regime n) (pi : Perm n) :
    canonical (rename r pi) = canonical r := rfl

/-! ## 3. Parity-Blindness on Machine Observables -/

/-- Certified machine state observables factor through canonical serialization. -/
def MachineObservable {n : Nat} (f : Regime n → Int) : Prop :=
  ∃ (g : CanonicalKey n → Int), ∀ r, f r = g (canonical r)

theorem observable_orbit_invariance {n : Nat} (f : Regime n → Int)
    (h_obs : MachineObservable f) (r : Regime n) (pi : Perm n) :
    f (rename r pi) = f r := by
  rcases h_obs with ⟨g, hg⟩
  rw [hg, hg, canonical_orbit_invariance]

/-- Theorem 2.1 (Parity-Blindness on the Carrier):
Any machine observable that claims to invert sign under odd permutations must vanish identically. -/
theorem carrier_parity_blind {n : Nat} (f : Regime n → Int)
    (h_obs : MachineObservable f) (pi : Perm n)
    (h_inv : ∀ r, f (rename r pi) = - f r) :
    ∀ r, f r = 0 := by
  intro r
  have h1 : f (rename r pi) = f r := observable_orbit_invariance f h_obs r pi
  have h2 : f (rename r pi) = - f r := h_inv r
  omega

/-! ## 4. Target B2 Witness Disjunct: Rigid vs. Symmetric Regimes -/

structure Witness2 where
  key : Nat
  piOpt : Perm2
  deriving DecidableEq

def projWitness (w : Witness2) : Nat := w.key

/-- Rigid 2-coordinate regime with distinct presentation tokens. -/
def rigid2 : Regime 2 := ⟨fun | ⟨0, _⟩ => 10 | ⟨1, _⟩ => 20, 42⟩

/-- Auxiliary solver routine that finds optimizing presentation ordering. -/
def solveWitness (r : Regime 2) : Witness2 :=
  if r.tokens ⟨0, by decide⟩ ≤ r.tokens ⟨1, by decide⟩ then
    ⟨canonical r, Perm2.id⟩
  else
    ⟨canonical r, Perm2.tau⟩

/-- Auxiliary search projection: certified machine state discards the witness permutation. -/
theorem witness_projected_out (r : Regime 2) :
    projWitness (solveWitness r) = canonical r := by
  unfold solveWitness projWitness
  split <;> rfl

def tau2Perm : Perm 2 :=
  ⟨fun | ⟨0, _⟩ => ⟨1, by decide⟩ | ⟨1, _⟩ => ⟨0, by decide⟩,
   fun | ⟨0, _⟩ => ⟨1, by decide⟩ | ⟨1, _⟩ => ⟨0, by decide⟩⟩

/-- On the rigid regime, transposition inverts the witness permutation. -/
theorem rigid_witness_inverts :
    (solveWitness (rename rigid2 tau2Perm)).piOpt = Perm2.tau ∧
    (solveWitness rigid2).piOpt = Perm2.id := by
  dsimp [solveWitness, rename, rigid2, tau2Perm]
  decide

/-- Sign inversion of the rigid witness under coordinate transposition. -/
theorem rigid_witness_sign_inverts :
    sgn2 (solveWitness (rename rigid2 tau2Perm)).piOpt = Sign.neg ∧
    sgn2 (solveWitness rigid2).piOpt = Sign.pos := by
  dsimp [solveWitness, rename, rigid2, tau2Perm, sgn2]
  decide

/-- Symmetric 2-coordinate regime with identical presentation tokens. -/
def symm2 : Regime 2 := ⟨fun _ => 0, 99⟩

/-- On the symmetric regime, tie-breaking preserves the identity witness. -/
theorem symm_witness_preserved :
    (solveWitness (rename symm2 tau2Perm)).piOpt = Perm2.id ∧
    (solveWitness symm2).piOpt = Perm2.id := by
  dsimp [solveWitness, rename, symm2, tau2Perm]
  decide

/-- On the symmetric regime, the witness sign product is positive (+1). -/
theorem symm_witness_sign_product :
    Sign.mul (sgn2 (solveWitness (rename symm2 tau2Perm)).piOpt)
             (sgn2 (solveWitness symm2).piOpt) = Sign.pos := by
  dsimp [solveWitness, rename, symm2, tau2Perm, sgn2]
  decide

end Carrier
