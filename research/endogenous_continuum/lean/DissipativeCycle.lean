-- research/endogenous_continuum/lean/DissipativeCycle.lean
-- Track 3: Dissipative Cycle Filtering
-- AuthorityEffect: None.

/-!
# Track 3: Dissipative Cycle Filtering

Constructive formalization of dissipative cycle filtering within discrete relational structures:
1. Stepping dynamic over carrier states with operational costs μ1 and μ2.
2. Potential function Φ : State → Int where μ1(s, s') = Φ(s) - Φ(s').
3. Acyclic paths: strictly dissipative transitions where potential decreases monotonically,
   with finite termination on bounded carriers.
4. Conservative-potential cycles: closed paths where net potential ∮ μ1 = 0
   while operational activity / duration ∮ μ2 > 0.
5. State-space pruning and attractor classification: transient dissipative states versus cycle attractors.

Axioms: strictly within {propext, Quot.sound}. Zero Classical.choice. Zero mathlib.
-/

namespace DissipativeCycle

set_option linter.unusedVariables false

-- ============================================================================
-- 1. Autonomous Stepping Dynamic and Operational Costs
-- ============================================================================

/-- Autonomous stepping dynamic over carrier states with operational costs. -/
structure AutonomousDynamic (State : Type) where
  step : State → State
  Φ : State → Int
  μ2 : State → State → Nat
  μ2_pos : ∀ s, μ2 s (step s) > 0

/-- Operational cost μ1: the potential difference between two states. -/
def μ1 {State : Type} (Φ : State → Int) (s s' : State) : Int :=
  Φ s - Φ s'

/-- Discrete path integral of μ1 (net potential change) along a sequence of states. -/
def path_μ1 {State : Type} (Φ : State → Int) : List State → Int
  | [] => 0
  | [_] => 0
  | s1 :: s2 :: rest => (Φ s1 - Φ s2) + path_μ1 Φ (s2 :: rest)

/-- Discrete path integral of μ2 (operational activity / duration) along a sequence of states. -/
def path_μ2 {State : Type} (μ2 : State → State → Nat) : List State → Nat
  | [] => 0
  | [_] => 0
  | s1 :: s2 :: rest => μ2 s1 s2 + path_μ2 μ2 (s2 :: rest)

/-- Validity predicate for a path of transitions under an autonomous stepping function. -/
def isValidPath {State : Type} (step : State → State) : List State → Prop
  | [] => True
  | [_] => True
  | s1 :: s2 :: rest => s2 = step s1 ∧ isValidPath step (s2 :: rest)

/-- n-th iterate of the autonomous step dynamic. -/
def iterateStep {State : Type} (step : State → State) : Nat → State → State
  | 0, s => s
  | n + 1, s => iterateStep step n (step s)

theorem iterateStep_succ_right {State : Type} (step : State → State) (n : Nat) (s : State) :
    iterateStep step (n + 1) s = step (iterateStep step n s) := by
  induction n generalizing s with
  | zero => rfl
  | succ n ih =>
    simp only [iterateStep]
    exact ih (step s)

theorem iterateStep_add {State : Type} (step : State → State) (m n : Nat) (s : State) :
    iterateStep step (m + n) s = iterateStep step m (iterateStep step n s) := by
  induction n generalizing s with
  | zero => rfl
  | succ n ih =>
    simp only [iterateStep]
    exact ih (step s)

theorem iterateStep_comm {State : Type} (step : State → State) (m n : Nat) (s : State) :
    iterateStep step m (iterateStep step n s) = iterateStep step n (iterateStep step m s) := by
  rw [← iterateStep_add, Nat.add_comm, iterateStep_add]

/-- Trajectory list of states generated by n steps from an initial state. -/
def trajectory {State : Type} (step : State → State) (s : State) : Nat → List State
  | 0 => [s]
  | n + 1 => s :: trajectory step (step s) n

theorem trajectory_length {State : Type} (step : State → State) (s : State) (n : Nat) :
    (trajectory step s n).length = n + 1 := by
  induction n generalizing s with
  | zero => rfl
  | succ n ih =>
    simp only [trajectory, List.length_cons]
    rw [ih (step s)]

theorem getLastD_cons_cons {α : Type} (x y : α) (xs : List α) (d : α) :
    (x :: y :: xs).getLastD d = (y :: xs).getLastD d := by
  simp [List.getLastD]

theorem trajectory_getLastD {State : Type} (step : State → State) (s : State) (n : Nat) (d : State) :
    (trajectory step s n).getLastD d = iterateStep step n s := by
  induction n generalizing s with
  | zero => rfl
  | succ n ih =>
    cases n with
    | zero =>
      simp [trajectory, iterateStep, List.getLastD]
    | succ m =>
      simp only [trajectory]
      rw [getLastD_cons_cons]
      exact ih (step s)

-- ============================================================================
-- 2. Acyclic Strictly Dissipative Paths and Finite Termination
-- ============================================================================

/-- A single transition step is strictly dissipative if the potential decreases. -/
def IsDissipativeStep {State : Type} (step : State → State) (Φ : State → Int) (s : State) : Prop :=
  Φ (step s) < Φ s

/-- A trajectory of n steps from s is strictly dissipative if every transition strictly decreases potential. -/
def IsDissipativeTrajectory {State : Type} (step : State → State) (Φ : State → Int) (s : State) (n : Nat) : Prop :=
  ∀ i < n, IsDissipativeStep step Φ (iterateStep step i s)

/-- Potential strictly decreases by at least n units over n dissipative steps. -/
theorem dissipative_trajectory_drop {State : Type} (step : State → State) (Φ : State → Int) (s : State) (n : Nat)
    (h : IsDissipativeTrajectory step Φ s n) :
    Φ (iterateStep step n s) ≤ Φ s - (n : Int) := by
  induction n with
  | zero =>
    simp [iterateStep]
  | succ n ih =>
    have h_prefix : IsDissipativeTrajectory step Φ s n :=
      fun i hi => h i (Nat.lt_trans hi (Nat.lt_succ_self n))
    have ih_val := ih h_prefix
    have h_step : IsDissipativeStep step Φ (iterateStep step n s) :=
      h n (Nat.lt_succ_self n)
    rw [iterateStep_succ_right]
    dsimp [IsDissipativeStep] at h_step
    omega

/-- Dissipative trajectories cannot close into a cycle: forward steps have strictly lower potential. -/
theorem dissipative_trajectory_not_closed {State : Type} (step : State → State) (Φ : State → Int) (s : State)
    (k : Nat) (hk : k > 0) (h_traj : IsDissipativeTrajectory step Φ s k) :
    iterateStep step k s ≠ s := by
  intro h_eq
  have h_drop := dissipative_trajectory_drop step Φ s k h_traj
  rw [h_eq] at h_drop
  omega

/-- Dissipative paths are acyclic: all states along a strictly dissipative trajectory are distinct. -/
theorem dissipative_trajectory_acyclic {State : Type} (step : State → State) (Φ : State → Int) (s : State)
    (n : Nat) (h_traj : IsDissipativeTrajectory step Φ s n) :
    ∀ i j, i < j → j ≤ n → iterateStep step i s ≠ iterateStep step j s := by
  intro i j hij hjn
  intro h_eq
  have h_sub : IsDissipativeTrajectory step Φ (iterateStep step i s) (j - i) := by
    intro m hm
    have hm_lt : i + m < n := by omega
    have h_step := h_traj (i + m) hm_lt
    rw [← iterateStep_add, Nat.add_comm m i]
    exact h_step
  have hj_sub : j - i > 0 := by omega
  have h_not_closed := dissipative_trajectory_not_closed step Φ (iterateStep step i s) (j - i) hj_sub h_sub
  have h_shift : iterateStep step (j - i) (iterateStep step i s) = iterateStep step j s := by
    rw [← iterateStep_add]
    congr 1
    omega
  rw [h_shift, ← h_eq] at h_not_closed
  exact h_not_closed rfl

/-- acyclic_dissipative_terminates: strictly decreasing potential implies acyclic paths terminate
    on any carrier where potential is bounded below by B. -/
theorem acyclic_dissipative_terminates {State : Type} (step : State → State) (Φ : State → Int) (B : Int)
    (h_bound : ∀ s, Φ s ≥ B) (s : State) :
    ∃ K : Nat, ∀ n : Nat, IsDissipativeTrajectory step Φ s n → n ≤ K := by
  refine ⟨(Φ s - B).toNat, ?_⟩
  intro n h_traj
  have h_drop := dissipative_trajectory_drop step Φ s n h_traj
  have h_bnd := h_bound (iterateStep step n s)
  omega

-- ============================================================================
-- 3. Conservative-Potential Cycles
-- ============================================================================

theorem path_μ1_cons_cons {State : Type} (Φ : State → Int) (s1 s2 : State) (rest : List State) :
    path_μ1 Φ (s1 :: s2 :: rest) = (Φ s1 - Φ s2) + path_μ1 Φ (s2 :: rest) := rfl

/-- Telescoping sum of potential differences along any path. -/
theorem path_μ1_telescope {State : Type} (Φ : State → Int) (s : State) (rest : List State) :
    path_μ1 Φ (s :: rest) = Φ s - Φ (rest.getLastD s) := by
  induction rest generalizing s with
  | nil =>
    simp [path_μ1]
  | cons s' rs ih =>
    rw [path_μ1_cons_cons]
    rw [ih s']
    simp only [List.getLastD_cons]
    omega

/-- cycle_net_potential_zero: ∮ μ1 = 0 along any cycle of states returning to start. -/
theorem cycle_net_potential_zero {State : Type} (Φ : State → Int) (s : State) (rest : List State)
    (h_closed : rest.getLastD s = s) :
    path_μ1 Φ (s :: rest) = 0 := by
  rw [path_μ1_telescope]
  rw [h_closed]
  omega

/-- Trajectory cycle net potential is zero. -/
theorem trajectory_cycle_net_potential_zero {State : Type} (step : State → State) (Φ : State → Int)
    (s : State) (k : Nat) (hk : k > 0) (h_loop : iterateStep step k s = s) :
    path_μ1 Φ (trajectory step s k) = 0 := by
  cases k with
  | zero => contradiction
  | succ m =>
    simp only [trajectory]
    rw [path_μ1_telescope]
    rw [trajectory_getLastD]
    have h_eq : iterateStep step m (step s) = iterateStep step (m + 1) s := rfl
    rw [h_eq, h_loop]
    omega

/-- cycle_activity_strictly_positive: ∮ μ2 > 0 along any non-empty transition cycle. -/
theorem cycle_activity_strictly_positive {State : Type} (step : State → State) (μ2 : State → State → Nat)
    (h_pos : ∀ s, μ2 s (step s) > 0)
    (s1 s2 : State) (rest : List State)
    (h_valid : isValidPath step (s1 :: s2 :: rest)) :
    path_μ2 μ2 (s1 :: s2 :: rest) > 0 := by
  have h_step : s2 = step s1 := h_valid.1
  rw [path_μ2]
  rw [h_step]
  have h1 : μ2 s1 (step s1) > 0 := h_pos s1
  omega

/-- Trajectory cycle operational activity is strictly positive. -/
theorem trajectory_cycle_activity_strictly_positive {State : Type} (step : State → State) (μ2 : State → State → Nat)
    (h_pos : ∀ s, μ2 s (step s) > 0) (s : State) (k : Nat) (hk : k > 0) :
    path_μ2 μ2 (trajectory step s k) > 0 := by
  cases k with
  | zero => contradiction
  | succ m =>
    cases m with
    | zero =>
      simp only [trajectory, path_μ2]
      exact h_pos s
    | succ p =>
      simp only [trajectory]
      have h1 : path_μ2 μ2 (s :: step s :: trajectory step (step (step s)) p) =
                μ2 s (step s) + path_μ2 μ2 (step s :: trajectory step (step (step s)) p) := rfl
      rw [h1]
      have h_step_pos := h_pos s
      omega

/-- A conservative-potential cycle attractor in the autonomous dynamic. -/
structure ConservativeCycle {State : Type} (step : State → State) (Φ : State → Int) (μ2 : State → State → Nat) where
  start : State
  period : Nat
  period_pos : period > 0
  closed : iterateStep step period start = start

/-- Any conservative cycle has zero net potential change. -/
theorem conservative_cycle_net_potential_zero {State : Type} (step : State → State) (Φ : State → Int)
    (μ2 : State → State → Nat) (c : ConservativeCycle step Φ μ2) :
    path_μ1 Φ (trajectory step c.start c.period) = 0 :=
  trajectory_cycle_net_potential_zero step Φ c.start c.period c.period_pos c.closed

/-- Any conservative cycle has strictly positive operational activity. -/
theorem conservative_cycle_activity_strictly_positive {State : Type} (step : State → State) (Φ : State → Int)
    (μ2 : State → State → Nat) (h_pos : ∀ s, μ2 s (step s) > 0) (c : ConservativeCycle step Φ μ2) :
    path_μ2 μ2 (trajectory step c.start c.period) > 0 :=
  trajectory_cycle_activity_strictly_positive step μ2 h_pos c.start c.period c.period_pos

-- ============================================================================
-- 4. State-Space Pruning and Attractor Classification
-- ============================================================================

/-- A state is transient acyclic if it never returns to itself in any positive number of steps. -/
def IsTransientAcyclic {State : Type} (step : State → State) (s : State) : Prop :=
  ∀ k : Nat, k > 0 → iterateStep step k s ≠ s

/-- A state belongs to a cycle attractor if it recurs after k > 0 steps. -/
def IsCycleAttractor {State : Type} (step : State → State) (s : State) : Prop :=
  ∃ k : Nat, k > 0 ∧ iterateStep step k s = s

/-- Filtering predicate: a state is preserved if it is not transient acyclic. -/
def Preserved {State : Type} (step : State → State) (s : State) : Prop :=
  ¬ IsTransientAcyclic step s

/-- Any strictly dissipative state is transient acyclic and cannot be a cycle attractor. -/
theorem dissipative_is_transient {State : Type} (step : State → State) (Φ : State → Int) (s : State)
    (h_diss : ∀ k > 0, IsDissipativeTrajectory step Φ s k) :
    IsTransientAcyclic step s := by
  intro k hk
  exact dissipative_trajectory_not_closed step Φ s k hk (h_diss k hk)

/-- attractor_pruning_soundness: removing transient acyclic states preserves all conservative cycle attractors. -/
theorem attractor_pruning_soundness {State : Type} (step : State → State) (s : State)
    (h_attr : IsCycleAttractor step s) :
    Preserved step s := by
  intro h_trans
  rcases h_attr with ⟨k, hk_pos, hk_eq⟩
  have h_ne := h_trans k hk_pos
  exact h_ne hk_eq

/-- Every state along a conservative cycle trajectory is an attractor. -/
theorem cycle_state_is_attractor {State : Type} (step : State → State) (s : State) (k : Nat)
    (hk : k > 0) (h_loop : iterateStep step k s = s) (i : Nat) :
    IsCycleAttractor step (iterateStep step i s) := by
  refine ⟨k, hk, ?_⟩
  rw [iterateStep_comm, h_loop]

/-- Pruning soundness for full cycles: every state along a conservative cycle is preserved under filtering. -/
theorem attractor_pruning_soundness_cycle {State : Type} (step : State → State) (s : State) (k : Nat)
    (hk : k > 0) (h_loop : iterateStep step k s = s) (i : Nat) :
    Preserved step (iterateStep step i s) := by
  apply attractor_pruning_soundness
  exact cycle_state_is_attractor step s k hk h_loop i

/-- Removing transient acyclic states preserves the start state of every conservative cycle. -/
theorem conservative_cycle_preserves_start {State : Type} (step : State → State) (Φ : State → Int)
    (μ2 : State → State → Nat) (c : ConservativeCycle step Φ μ2) :
    Preserved step c.start :=
  attractor_pruning_soundness step c.start ⟨c.period, c.period_pos, c.closed⟩

