-- ============================================================================

#print axioms acyclic_dissipative_terminates
#print axioms cycle_net_potential_zero
#print axioms cycle_activity_strictly_positive
#print axioms attractor_pruning_soundness
#print axioms trajectory_cycle_net_potential_zero
#print axioms trajectory_cycle_activity_strictly_positive
#print axioms attractor_pruning_soundness_cycle
#print axioms conservative_cycle_net_potential_zero
#print axioms conservative_cycle_activity_strictly_positive
#print axioms conservative_cycle_preserves_start
#print axioms dissipative_trajectory_acyclic

end DissipativeCycle
