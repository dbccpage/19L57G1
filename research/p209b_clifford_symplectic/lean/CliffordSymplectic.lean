/-!
# Discrete Clifford Group Quotient & Finite Symplectic Geometry (Target P209b)

Formalizes:
1. Exact field F_2 arithmetic, 2D phase_space vectors, and 2x2 matrices.
2. Canonical symplectic form omega(u, v) = u_x * v_z + u_z * v_x over F_2^2.
3. The 6 explicit matrices of Sp(2, F_2) =~ S_3:
   I, H, S, SH, HS, HSH.
4. Determinant 1 mod 2 for all 6 elements.
5. Canonical pairing omega(e_x, e_z) = 1.
6. Symplectic preservation omega(M u, M v) = omega(u, v) for all 6 elements.
7. Mutual distinctness of all 15 distinct pairs among the 6 elements.
8. Element orders: order 2 reflections (H, S, HSH) and order 3 rotations (SH, HS).
9. Eastin-Knill finite quotient obstruction:
   The group generated by transversal Clifford operations H and S is strictly
   closed within the 6-element quotient Sp(2, F_2), precluding dense covering.

AuthorityEffect: None.
Axiom Scope: Constructive core Lean 4; axioms strictly in {propext, Quot.sound};
zero Classical.choice; zero mathlib.
-/

namespace P209bCliffordSymplectic

/-- Field F_2 with elements zero and one. -/
inductive F2 : Type
  | zero : F2
  | one : F2
  deriving DecidableEq, Repr

namespace F2

def add : F2 → F2 → F2
  | .zero, y => y
  | .one, .zero => .one
  | .one, .one => .zero

def mul : F2 → F2 → F2
  | .zero, _ => .zero
  | .one, y => y

instance : OfNat F2 0 where
  ofNat := .zero

instance : OfNat F2 1 where
  ofNat := .one

instance : Add F2 where
  add := add

instance : Mul F2 where
  mul := mul

theorem add_comm (x y : F2) : x + y = y + x := by
  cases x <;> cases y <;> rfl

theorem mul_comm (x y : F2) : x * y = y * x := by
  cases x <;> cases y <;> rfl

theorem zero_ne_one : (0 : F2) ≠ 1 := by
  intro h
  nomatch h

end F2

/-- 2D vector in phase_space over F_2. -/
structure Vec2 where
  x : F2
  z : F2
  deriving DecidableEq, Repr

/-- 2x2 matrix over F_2. -/
structure Mat2 where
  a : F2
  b : F2
  c : F2
  d : F2
  deriving DecidableEq, Repr

def matMul (m1 m2 : Mat2) : Mat2 :=
  ⟨m1.a * m2.a + m1.b * m2.c,
   m1.a * m2.b + m1.b * m2.d,
   m1.c * m2.a + m1.d * m2.c,
   m1.c * m2.b + m1.d * m2.d⟩

def det (m : Mat2) : F2 :=
  m.a * m.d + m.b * m.c

def matMulVec (m : Mat2) (v : Vec2) : Vec2 :=
  ⟨m.a * v.x + m.b * v.z,
   m.c * v.x + m.d * v.z⟩

/-- Canonical symplectic bilinear form on F_2^2: omega(u, v) = u_x * v_z + u_z * v_x. -/
def omega (u v : Vec2) : F2 :=
  u.x * v.z + u.z * v.x

def ex : Vec2 := ⟨1, 0⟩
def ez : Vec2 := ⟨0, 1⟩

/-- Symplectic form antisymmetry (which is symmetry in characteristic 2). -/
theorem omega_symm (u v : Vec2) : omega u v = omega v u := by
  cases u with | mk ux uz =>
  cases v with | mk vx vz =>
  cases ux <;> cases uz <;> cases vx <;> cases vz <;> rfl

theorem omega_self (u : Vec2) : omega u u = 0 := by
  cases u with | mk ux uz =>
  cases ux <;> cases uz <;> rfl

theorem canonical_pairing : omega ex ez = 1 := by rfl
theorem canonical_pairing_rev : omega ez ex = 1 := by rfl

-- =============================================================================
-- The 6 matrices of Sp(2, F_2)
-- =============================================================================

def matI   : Mat2 := ⟨1, 0, 0, 1⟩
def matH   : Mat2 := ⟨0, 1, 1, 0⟩
def matS   : Mat2 := ⟨1, 0, 1, 1⟩
def matSH  : Mat2 := ⟨0, 1, 1, 1⟩
def matHS  : Mat2 := ⟨1, 1, 1, 0⟩
def matHSH : Mat2 := ⟨1, 1, 0, 1⟩

theorem det_matI   : det matI   = 1 := by rfl
theorem det_matH   : det matH   = 1 := by rfl
theorem det_matS   : det matS   = 1 := by rfl
theorem det_matSH  : det matSH  = 1 := by rfl
theorem det_matHS  : det matHS  = 1 := by rfl
theorem det_matHSH : det matHSH = 1 := by rfl

-- Symplectic preservation for all 6 matrices
theorem symplectic_preservation_I (u v : Vec2) :
    omega (matMulVec matI u) (matMulVec matI v) = omega u v := by
  cases u with | mk ux uz =>
  cases v with | mk vx vz =>
  cases ux <;> cases uz <;> cases vx <;> cases vz <;> rfl

theorem symplectic_preservation_H (u v : Vec2) :
    omega (matMulVec matH u) (matMulVec matH v) = omega u v := by
  cases u with | mk ux uz =>
  cases v with | mk vx vz =>
  cases ux <;> cases uz <;> cases vx <;> cases vz <;> rfl

theorem symplectic_preservation_S (u v : Vec2) :
    omega (matMulVec matS u) (matMulVec matS v) = omega u v := by
  cases u with | mk ux uz =>
  cases v with | mk vx vz =>
  cases ux <;> cases uz <;> cases vx <;> cases vz <;> rfl

theorem symplectic_preservation_SH (u v : Vec2) :
    omega (matMulVec matSH u) (matMulVec matSH v) = omega u v := by
  cases u with | mk ux uz =>
  cases v with | mk vx vz =>
  cases ux <;> cases uz <;> cases vx <;> cases vz <;> rfl

theorem symplectic_preservation_HS (u v : Vec2) :
    omega (matMulVec matHS u) (matMulVec matHS v) = omega u v := by
  cases u with | mk ux uz =>
  cases v with | mk vx vz =>
  cases ux <;> cases uz <;> cases vx <;> cases vz <;> rfl

theorem symplectic_preservation_HSH (u v : Vec2) :
    omega (matMulVec matHSH u) (matMulVec matHSH v) = omega u v := by
  cases u with | mk ux uz =>
  cases v with | mk vx vz =>
  cases ux <;> cases uz <;> cases vx <;> cases vz <;> rfl

-- Mutual distinctness (15 pairs)
theorem matI_ne_matH   : matI ≠ matH   := by intro h; nomatch h
theorem matI_ne_matS   : matI ≠ matS   := by intro h; nomatch h
theorem matI_ne_matSH  : matI ≠ matSH  := by intro h; nomatch h
theorem matI_ne_matHS  : matI ≠ matHS  := by intro h; nomatch h
theorem matI_ne_matHSH : matI ≠ matHSH := by intro h; nomatch h

theorem matH_ne_matS   : matH ≠ matS   := by intro h; nomatch h
theorem matH_ne_matSH  : matH ≠ matSH  := by intro h; nomatch h
theorem matH_ne_matHS  : matH ≠ matHS  := by intro h; nomatch h
theorem matH_ne_matHSH : matH ≠ matHSH := by intro h; nomatch h

theorem matS_ne_matSH  : matS ≠ matSH  := by intro h; nomatch h
theorem matS_ne_matHS  : matS ≠ matHS  := by intro h; nomatch h
theorem matS_ne_matHSH : matS ≠ matHSH := by intro h; nomatch h

theorem matSH_ne_matHS  : matSH ≠ matHS  := by intro h; nomatch h
theorem matSH_ne_matHSH : matSH ≠ matHSH := by intro h; nomatch h

theorem matHS_ne_matHSH : matHS ≠ matHSH := by intro h; nomatch h

-- Element orders: order 2 reflections
theorem order_matH   : matMul matH matH = matI := by rfl
theorem order_matS   : matMul matS matS = matI := by rfl
theorem order_matHSH : matMul matHSH matHSH = matI := by rfl

-- Element orders: order 3 rotations
theorem matSH_sq_eq_matHS : matMul matSH matSH = matHS := by rfl
theorem matHS_sq_eq_matSH : matMul matHS matHS = matSH := by rfl
theorem order_matSH : matMul matSH (matMul matSH matSH) = matI := by rfl
theorem order_matHS : matMul matHS (matMul matHS matHS) = matI := by rfl

-- Generator relations
theorem matSH_def : matMul matS matH = matSH := by rfl
theorem matHS_def : matMul matH matS = matHS := by rfl
theorem matHSH_def : matMul matH matSH = matHSH := by rfl
theorem matSHS_eq_matHSH : matMul matS matHS = matHSH := by rfl

-- =============================================================================
-- Eastin-Knill finite quotient obstruction
-- =============================================================================

/-- Predicate characterizing membership in Sp(2, F_2). -/
def inSp2 (m : Mat2) : Prop :=
  m = matI ∨ m = matH ∨ m = matS ∨ m = matSH ∨ m = matHS ∨ m = matHSH

theorem sp2_has_I   : inSp2 matI   := Or.inl rfl
theorem sp2_has_H   : inSp2 matH   := Or.inr (Or.inl rfl)
theorem sp2_has_S   : inSp2 matS   := Or.inr (Or.inr (Or.inl rfl))
theorem sp2_has_SH  : inSp2 matSH  := Or.inr (Or.inr (Or.inr (Or.inl rfl)))
theorem sp2_has_HS  : inSp2 matHS  := Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl))))
theorem sp2_has_HSH : inSp2 matHSH := Or.inr (Or.inr (Or.inr (Or.inr (Or.inr rfl))))

/-- Multiplication table closure for Sp(2, F_2). -/
theorem sp2_mul_closure (m1 m2 : Mat2) (h1 : inSp2 m1) (h2 : inSp2 m2) :
    inSp2 (matMul m1 m2) := by
  rcases h1 with rfl | rfl | rfl | rfl | rfl | rfl <;>
  rcases h2 with rfl | rfl | rfl | rfl | rfl | rfl <;>
  first
  | exact Or.inl rfl
  | exact Or.inr (Or.inl rfl)
  | exact Or.inr (Or.inr (Or.inl rfl))
  | exact Or.inr (Or.inr (Or.inr (Or.inl rfl)))
  | exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl rfl))))
  | exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr rfl))))

/-- Inductive group generation by transversal gates H and S. -/
inductive GeneratedByHS : Mat2 → Prop
  | id : GeneratedByHS matI
  | genH : GeneratedByHS matH
  | genS : GeneratedByHS matS
  | mul {m1 m2 : Mat2} : GeneratedByHS m1 → GeneratedByHS m2 → GeneratedByHS (matMul m1 m2)

/-- Eastin-Knill finite quotient obstruction theorem:
Any matrix generated by transversal Clifford operations H and S
belongs to the strictly finite 6-element group Sp(2, F_2),
algebraically precluding dense generation of continuous operations. -/
theorem eastin_knill_finite_quotient_obstruction (m : Mat2) (h : GeneratedByHS m) :
    inSp2 m := by
  induction h with
  | id => exact sp2_has_I
  | genH => exact sp2_has_H
  | genS => exact sp2_has_S
  | mul _ _ ih1 ih2 => exact sp2_mul_closure _ _ ih1 ih2

end P209bCliffordSymplectic
