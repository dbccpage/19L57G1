import Trace
import Factorization

/-!
# Observer trace congruence and residual-free future continuations

Formalizes the observer trace congruence theorem:
  Two states indistinguishable under all admitted observation projections preserve
  identical future continuation distributions without unrecorded residuals.

Target G013: Coherent Trace Calculus & Higher Cell Algebra.
Constructive formalization in Lean 4 without Classical.choice or Mathlib.
AuthorityEffect: None.
-/

namespace G013TraceCalculus

/-- An admitted observation projection mapping internal states σ to observable readings ω. -/
structure Observer (σ : Type) (ω : Type) where
  obs : σ → ω

/-- Observable readout generated by executing an action sequence k from base state s. -/
def obsReplay {σ ω : Type} (sys : System σ) (ob : Observer σ ω) (s : σ) (k : List String) : ω :=
  ob.obs (replay sys s k)

/-- Observer Trace Congruence:
Two states s1 and s2 are observationally congruent if all execution continuations k
produce identical observable readouts. -/
def ObserverCongruent {σ ω : Type} (sys : System σ) (ob : Observer σ ω) (s1 s2 : σ) : Prop :=
  ∀ (k : List String), obsReplay sys ob s1 k = obsReplay sys ob s2 k

/-- Reflexivity of observer trace congruence. -/
theorem observer_congruent_refl {σ ω : Type} (sys : System σ) (ob : Observer σ ω) (s : σ) :
    ObserverCongruent sys ob s s :=
  fun _ => rfl

/-- Symmetry of observer trace congruence. -/
theorem observer_congruent_symm {σ ω : Type} (sys : System σ) (ob : Observer σ ω) {s1 s2 : σ}
    (h : ObserverCongruent sys ob s1 s2) :
    ObserverCongruent sys ob s2 s1 :=
  fun k => (h k).symm

/-- Transitivity of observer trace congruence. -/
theorem observer_congruent_trans {σ ω : Type} (sys : System σ) (ob : Observer σ ω) {s1 s2 s3 : σ}
    (h12 : ObserverCongruent sys ob s1 s2)
    (h23 : ObserverCongruent sys ob s2 s3) :
    ObserverCongruent sys ob s1 s3 :=
  fun k => (h12 k).trans (h23 k)

/-- Observer congruent states share identical immediate observation readings (k = []). -/
theorem observer_congruent_immediate {σ ω : Type} (sys : System σ) (ob : Observer σ ω) {s1 s2 : σ}
    (h : ObserverCongruent sys ob s1 s2) :
    ob.obs s1 = ob.obs s2 := by
  have h_empty := h []
  exact h_empty

/-- Single-step preservation: observer congruence is stable under transition stepping. -/
theorem observer_congruent_step {σ ω : Type} (sys : System σ) (ob : Observer σ ω) {s1 s2 : σ}
    (h : ObserverCongruent sys ob s1 s2) (a : String) :
    ObserverCongruent sys ob (sys.step s1 a) (sys.step s2 a) := by
  intro k
  exact h (a :: k)

/-- Continuation agreement: identical future trajectory readouts across all event suffixes. -/
theorem observer_trace_congruence_preserves_continuations {σ ω : Type}
    (sys : System σ) (ob : Observer σ ω) {s1 s2 : σ}
    (h : ObserverCongruent sys ob s1 s2) (k : List String) :
    obsReplay sys ob s1 k = obsReplay sys ob s2 k :=
  h k

/-- Suffix composition invariance under observer trace congruence. -/
theorem observer_congruent_suffix_composition {σ ω : Type}
    (sys : System σ) (ob : Observer σ ω) {s1 s2 : σ}
    (h : ObserverCongruent sys ob s1 s2) (k1 k2 : List String) :
    obsReplay sys ob s1 (k1 ++ k2) = obsReplay sys ob s2 (k1 ++ k2) :=
  h (k1 ++ k2)

/-- Absence of unrecorded residuals: if s1 and s2 are congruent, no observation
sequence can differentiate their future continuations. -/
theorem quotient_zero_residuals {σ ω : Type} (sys : System σ) (ob : Observer σ ω) {s1 s2 : σ}
    (h : ObserverCongruent sys ob s1 s2) :
    (∀ (k : List String), obsReplay sys ob s1 k = obsReplay sys ob s2 k) ∧
    (ob.obs s1 = ob.obs s2) :=
  ⟨h, observer_congruent_immediate sys ob h⟩

end G013TraceCalculus
