  "Clears": "def Clears {d : Nat} (S : LocalStrategy d) : Prop :=\n  \u2200 n, ClearsOn S n",
  "ClearsOn": "def ClearsOn {d : Nat} (S : LocalStrategy d) (n : Nat) : Prop :=\n  \u2200 i j, BaseObstructed n i j \u2192 S.view n i \u2260 S.view n j",
  "FiniteDeclaration": "def FiniteDeclaration {d : Nat} (k : Nat) (S : LocalStrategy d) : Prop :=\n  \u2200 n x, S.colour n x < k",
  "Fires": "def Fires {d : Nat} (_S : LocalStrategy d) : Prop :=\n  \u2203 n0, \u2200 n, n0 \u2264 n \u2192 \u2203 i j, BaseObstructed n i j",
  "IdentityGrade": "def IdentityGrade {d : Nat} (S : LocalStrategy d) : Prop :=\n  \u2200 n i j, i \u2264 n \u2192 j \u2264 n \u2192 i \u2260 j \u2192 S.view n i \u2260 S.view n j",
  "LocalStrategy": "structure LocalStrategy (d : Nat) where\n  importDiscipline : ImportDiscipline\n  colour : Nat \u2192 Nat \u2192 Nat\n  view : Nat \u2192 Nat \u2192 Nat\n  locality : \u2200 n, ViewLocal (view n) (colour n) d",
  "RecurringImport": "def RecurringImport {d : Nat} (S : LocalStrategy d) : Prop :=\n  S.importDiscipline = .recurring",
  "ViewLocal": "def ViewLocal (v : Nat \u2192 Nat) (colour : Nat \u2192 Nat) (d : Nat) : Prop :=\n  \u2203 g : List Nat \u2192 Nat, \u2200 i, v i = g (colourBall colour i d)",
  "class_exclusion": "theorem g1_class_exclusion {d : Nat} (S : LocalStrategy d) (k : Nat)\n    (hfinite : FiniteDeclaration k S) :\n    Fires S \u2227 \u00ac Clears S \u2227\n      \u00ac (Fires S \u2227 Clears S \u2227 \u00ac RecurringImport S) :="
